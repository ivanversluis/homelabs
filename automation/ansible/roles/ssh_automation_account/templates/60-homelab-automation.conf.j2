# Managed by Ansible role ssh_automation_account — do not edit by hand.
# Certificate trust and principals are scoped to the dedicated automation account only.
# Global PermitRootLogin/PasswordAuthentication baselines from sshd_config remain untouched.
Match User {{ automation_account_name }}
    TrustedUserCAKeys {{ trusted_user_ca_keys_path }}
    AuthorizedPrincipalsFile {{ auth_principals_file }}
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes
    AuthenticationMethods publickey
    DisableForwarding yes
