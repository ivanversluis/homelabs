{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],

  "mode": "full",
  "prCreation": "immediate",
  "recreateWhen": "always",
  "automerge": false,
  "automergeType": "pr",

  "dependencyDashboard": false,

  "timezone": "Europe/Amsterdam",
  "labels": [
    "renovate",
    "dependencies"
  ],
  "branchConcurrentLimit": 0,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,

  "flux": {
    "managerFilePatterns": [
      "/(^|/)infra/.+\\.ya?ml$/",
      "/(^|/)clusters/.+\\.ya?ml$/"
    ]
  },

  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)apps/.+\\.ya?ml$/",
      "/(^|/)services/.+\\.ya?ml$/",
      "/(^|/)infra/.+\\.ya?ml$/",
      "/(^|/)clusters/.+\\.ya?ml$/"
    ]
  },

  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)[^/]*docker-compose[^/]*\\.ya?ml$/",
      "/(^|/)stack-[^/]+\\.ya?ml$/",
      "/(^|/)docker-stack/[^/]+\\.ya?ml$/"
    ]
  },

  "github-actions": {
    "enabled": true
  },

  "enabledManagers": [
    "flux",
    "kubernetes",
    "docker-compose",
    "github-actions",
    "custom.regex"
  ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "Track split repository+tag image references in HelmRelease values blocks",
      "managerFilePatterns": [
        "/(^|/)infra/[^/]+/[^/]*helmrelease\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s+(?<depName>\\S+)\\n\\s+tag:\\s+[\"']?(?<currentValue>[\\w][\\w.\\-]*)[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "Group Flux CD system controller image updates",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/fluxcd\\//"
      ],
      "groupName": "Flux CD controllers",
      "automerge": false
    },
    {
      "description": "Group all Helm chart minor and patch version bumps",
      "matchManagers": [
        "flux"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Helm charts (minor & patch)",
      "automerge": false
    },
    {
      "description": "Group Authentik server image updates across K8s and Docker Compose",
      "matchPackageNames": [
        "/^ghcr\\.io\\/goauthentik\\//"
      ],
      "groupName": "Authentik images",
      "automerge": false
    },
    {
      "description": "Block postgres major version upgrades",
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Group redis base image minor and patch updates",
      "matchPackageNames": [
        "redis"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Base images (redis)",
      "automerge": false
    },
    {
      "description": "Label and isolate all major version updates for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "major-update",
        "renovate",
        "dependencies"
      ],
      "automerge": false
    }
  ]
}