    {
      "id": 13,
      "type": "text",
      "title": "Reading the weather and solar signals",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Current values** are Open-Meteo model estimates for the configured location; the exporter polls every 10 minutes and Prometheus scrapes every 15 minutes.  \n**Solar radiation (W/m²)** measures incoming sunlight, while **GoodWe power (W)** measures generated electrical power; the two are not numerically interchangeable.   \n**Forecast** provides 48 relative lead-hour readings for planning, not a reliable EV charging command. No location or coordinates are exposed in panels."
      },
      "transparent": true
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Temperature · outdoor versus indoor",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(weather_temperature_celsius{job=\"weather-prometheus-exporter\"}[30m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "legendFormat": "Outdoor (Open-Meteo)"
        },
        {
          "refId": "B",
          "expr": "avg(daikin_indoor_temperature_celsius)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true,
          "legendFormat": "Indoor (Daikin mean)"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "fillOpacity": 7,
            "lineInterpolation": "stepAfter",
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
