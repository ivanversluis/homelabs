    {
      "id": 1,
      "type": "stat",
      "title": "Outside temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(weather_temperature_celsius{job=\"weather-prometheus-exporter\"}[30m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
