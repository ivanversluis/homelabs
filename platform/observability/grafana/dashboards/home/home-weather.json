          "refId": "A",
          "expr": "max(last_over_time(weather_forecast_solar_radiation_watts_per_square_meter{job=\"weather-prometheus-exporter\",horizon_hours=~\"([0-9]|1[0-9]|2[0-3])\"}[30m]))",
