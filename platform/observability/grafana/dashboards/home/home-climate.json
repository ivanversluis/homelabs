{
  "title": "Home Climate",
  "uid": "home-climate",
  "tags": [
    "climate",
    "daikin",
    "home",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Indoor Temp",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(daikin_indoor_temperature_celsius{device_name=~\"$device\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 1,
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Target Temp",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(daikin_target_temperature_celsius{device_name=~\"$device\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 2,
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Outdoor Temp",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(daikin_outdoor_temperature_celsius{device_name=~\"$device\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 3,
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Units On",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(daikin_is_on{device_name=~\"$device\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 4,
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "Indoor vs outdoor temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "daikin_indoor_temperature_celsius{device_name=~\"$device\"}",
          "legendFormat": "{{device_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "daikin_outdoor_temperature_celsius{device_name=~\"$device\"}",
          "legendFormat": "outdoor · {{device_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "spanNulls": false,
            "fillOpacity": 0,
            "lineInterpolation": "stepAfter",
            "drawStyle": "line",
            "lineWidth": 2
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 5,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Room temperature vs setpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "daikin_indoor_temperature_celsius{device_name=~\"$device\"}",
          "legendFormat": "actual · {{device_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "daikin_target_temperature_celsius{device_name=~\"$device\"}",
          "legendFormat": "target · {{device_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "spanNulls": false,
            "fillOpacity": 0,
            "lineInterpolation": "stepAfter",
            "drawStyle": "line",
            "lineWidth": 2
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 6,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        }
      }
    },
    {
      "type": "state-timeline",
      "title": "Operating Mode",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "daikin_operating_mode{device_name=~\"$device\"}",
          "legendFormat": "{{device_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Off"
                },
                "1": {
                  "text": "Cooling"
                },
                "2": {
                  "text": "Heating"
                },
                "3": {
                  "text": "Fan"
                },
                "4": {
                  "text": "Dry"
                },
                "5": {
                  "text": "Auto"
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "state-timeline",
      "title": "Fan setting by room",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "daikin_fan_speed{device_name=~\"$device\"}",
          "legendFormat": "{{device_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Auto / other"
                },
                "1": {
                  "text": "Level 1"
                },
                "2": {
                  "text": "Level 2"
                },
                "3": {
                  "text": "Level 3"
                },
                "4": {
                  "text": "Level 4"
                },
                "5": {
                  "text": "Level 5"
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 8,
      "description": "Exporter codes: 1–5 are fixed levels; 0 is an automatic or nonnumeric setting. Missing series are not zero. The upstream exporter/device must expose fan data."
    },
    {
      "type": "stat",
      "title": "Scrape Errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(daikin_scrape_errors_total[24h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 9,
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Last successful API poll",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "daikin_last_scrape_success_timestamp * 1000",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "No data"
        },
        "overrides": []
      },
      "id": 10,
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 11,
      "title": "Time since successful API poll",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "time() - daikin_last_scrape_success_timestamp",
          "refId": "A",
          "legendFormat": "Poll age",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "description": "A healthy API poll is expected every 10 minutes. HTTP scrape health alone does not prove that the API poll succeeded.",
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 12,
      "title": "Exporter HTTP scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"daikin-prometheus-exporter\"}",
          "refId": "A",
          "legendFormat": "Daikin exporter",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    }
  ],
  "description": "Room comfort, setpoints and unit state from Daikin Onecta. API polling is every 10 minutes; missing fan data means the exporter/device did not expose a value.",
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(daikin_indoor_temperature_celsius, device_name)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(daikin_indoor_temperature_celsius, device_name)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      }
    ]
  },
  "id": null,
  "editable": false,
  "graphTooltip": 1,
