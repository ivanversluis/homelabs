    {
      "id": 9,
      "type": "table",
      "title": "Mounted PVCs missing kubelet volume metrics",
      "description": "An active PVC with no stats is a monitoring gap. Unmounted PVCs are intentionally excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 16,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No active claim missing stats"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (namespace, persistentvolumeclaim) (kube_pod_spec_volumes_persistentvolumeclaims_info{job=\"kube-state-metrics\"} * on(namespace,pod) group_left() (kube_pod_status_phase{job=\"kube-state-metrics\",phase=\"Running\"} == 1)) unless on(namespace,persistentvolumeclaim) max by (namespace,persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{job=\"kubernetes-kubelet-volumes\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Kubelet volume scrapes up (%)",
      "description": "Successful kubelet metric scrapes divided by configured scrape targets (not proof all PVCs export stats).",
