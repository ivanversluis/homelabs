        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - (max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_available_bytes{job=\"kubernetes-kubelet-volumes\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}) / clamp_min(max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{job=\"kubernetes-kubelet-volumes\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}), 1)))",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}"
