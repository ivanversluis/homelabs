        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "PVC capacity — requested vs actual filesystem",
      "description": "All requested claims appear even if the volume is unmounted and cannot report usage. Columns use bytes with IEC auto units. Empty usage is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (claim) (label_join(max by (namespace, persistentvolumeclaim) (kube_persistentvolumeclaim_resource_requests_storage_bytes{job=\"kube-state-metrics\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\"))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (claim) (label_join(max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{job=\"kubernetes-kubelet-volumes\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\"))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (claim) (label_join(max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{job=\"kubernetes-kubelet-volumes\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\"))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (claim) (label_join(max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_available_bytes{job=\"kubernetes-kubelet-volumes\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\"))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (claim) (label_join(100 * (1 - (max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_available_bytes{job=\"kubernetes-kubelet-volumes\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}) / clamp_min(max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{job=\"kubernetes-kubelet-volumes\",namespace=~\"$namespace\",persistentvolumeclaim=~\"$pvc\"}), 1))), \"claim\", \"/\", \"namespace\", \"persistentvolumeclaim\"))",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "claim",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "claim": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            },
            "renameByName": {
              "claim": "Namespace / PVC",
              "Value #A": "Requested",
              "Value #B": "Filesystem capacity",
              "Value #C": "Used",
              "Value #D": "Available",
              "Value #E": "Full %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Requested|Filesystem capacity|Used|Available)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Full %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 95
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Full %",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Filesystem fullness by PVC",
      "description": "File-system fullness = 100 × (1 - available/capacity), not Longhorn replica consumption.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No data",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
