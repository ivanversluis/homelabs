    {
      "id": 9,
      "type": "timeseries",
      "title": "Longhorn disk usage history %",
      "description": "History shows the increase toward Longhorn's disk scheduling limit; a disk can be unschedulable below the line.",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 65
              },
              {
                "color": "red",
                "value": 72
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (max by (node,disk) (longhorn_disk_usage_bytes{job=\"longhorn-manager\",node=~\"$node\"}) / clamp_min(max by (node,disk) (longhorn_disk_capacity_bytes{job=\"longhorn-manager\",node=~\"$node\"}), 1))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} / {{disk}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Unschedulable disks — Longhorn reason",
      "description": "Longhorn condition_reason per disk is shown when status=0. For detailed messages inspect node.longhorn.io CRD or Longhorn UI.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 16,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No failing disk conditions"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "min by (node,disk,condition_reason) (longhorn_disk_status{job=\"longhorn-manager\",condition=\"schedulable\",node=~\"$node\"}) == 0",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Longhorn Manager scrape up %",
      "description": "If no scrape targets exist, the panel shows No data rather than healthy. Loss of endpoint targets also has its own alert.",
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99.9
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(up{job=\"longhorn-manager\"}) / count(up{job=\"longhorn-manager\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Failing Longhorn node conditions",
      "description": "Shows node health, node scheduling, and administrative scheduling failures with native reason labels.",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No failing node conditions"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "min by (node,condition,condition_reason) (longhorn_node_status{job=\"longhorn-manager\",condition=~\"ready|schedulable|allowScheduling\",node=~\"$node\"}) == 0",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    }
  ]
