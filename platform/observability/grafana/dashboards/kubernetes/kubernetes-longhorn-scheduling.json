    {
      "id": 7,
      "title": "Longhorn disk capacity and scheduling",
      "description": "Physical disk capacity and used bytes are reported by Longhorn; reservation is excluded from replica scheduling, not automatically free space. The observed disk Schedulable condition is authoritative.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node_disk) (label_join(max by (node,disk) (longhorn_disk_capacity_bytes{job=\"longhorn-manager\",node=~\"$node\"}), \"node_disk\", \" / \", \"node\", \"disk\"))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node_disk) (label_join(max by (node,disk) (longhorn_disk_usage_bytes{job=\"longhorn-manager\",node=~\"$node\"}), \"node_disk\", \" / \", \"node\", \"disk\"))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node_disk) (label_join(max by (node,disk) (longhorn_disk_reservation_bytes{job=\"longhorn-manager\",node=~\"$node\"}), \"node_disk\", \" / \", \"node\", \"disk\"))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node_disk) (label_join(min by (node,disk) (longhorn_disk_status{job=\"longhorn-manager\",condition=\"ready\",node=~\"$node\"}), \"node_disk\", \" / \", \"node\", \"disk\"))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node_disk) (label_join(min by (node,disk) (longhorn_disk_status{job=\"longhorn-manager\",condition=\"schedulable\",node=~\"$node\"}), \"node_disk\", \" / \", \"node\", \"disk\"))",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node_disk) (label_join(100 * (max by (node,disk) (longhorn_disk_usage_bytes{job=\"longhorn-manager\",node=~\"$node\"}) / clamp_min(max by (node,disk) (longhorn_disk_capacity_bytes{job=\"longhorn-manager\",node=~\"$node\"}), 1)), \"node_disk\", \" / \", \"node\", \"disk\"))",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
