  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Longhorn replica scheduling and capacity",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Longhorn node Ready / Schedulable / AllowScheduling and disk Schedulable are separate from Kubernetes node health.** Three Longhorn-labeled workers are expected; both StorageClasses currently request **2 replicas**. Alerts: disk **>65% / 10m**, **>72% / 2m** (ahead of the default 75% scheduling boundary), disk or node unschedulable, fewer than three eligible nodes, and degraded/faulted volumes. **Longhorn condition metrics are the authoritative scheduling indicator:** reserved and allocated capacity can block new replicas before a disk reaches 75%. Missing metrics are not treated as healthy."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Longhorn nodes observed",
      "description": "Node count from Longhorn manager, not Kubernetes node-exporter.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(min by (node) (longhorn_node_status{job=\"longhorn-manager\",condition=\"ready\",node=~\"$node\"}))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodes eligible (with disk)",
      "description": "Node must be ready, schedulable, scheduling allowed, and have at least one Longhorn-schedulable disk.",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(min by(node) (longhorn_node_status{job=\"longhorn-manager\",condition=~\"ready|schedulable|allowScheduling\",node=~\"$node\"}) * on(node) max by(node) (min by (node,disk) (longhorn_disk_status{job=\"longhorn-manager\",condition=\"schedulable\",node=~\"$node\"})))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
