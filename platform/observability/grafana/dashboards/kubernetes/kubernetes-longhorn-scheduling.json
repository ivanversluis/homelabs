            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by(node) (min by (node,disk) (longhorn_disk_status{job=\"longhorn-manager\",condition=\"schedulable\",node=~\"$node\"}))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node) (longhorn_node_storage_capacity_bytes{job=\"longhorn-manager\",node=~\"$node\"})",
