  },
  "panels": [
    {
      "id": 8,
      "type": "text",
      "title": "Sustained resource warnings",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Root disk >70% for 4h · Memory >85% for 4h · CPU >90% for 30m**\n\nEach node/instance has its own alert. A threshold crossing begins Pending; recovery resets the timer. CPU is averaged over 5 minutes. Discord receives firing and resolved notifications through `discord-primary`."
      }
    },
    {
      "id": 1,
      "type": "bargauge",
      "title": "CPU usage % — current",
      "description": "Warning when usage stays > 90% for 30m. CPU uses a 5-minute idle rate; root disk uses available space (including reserved-space impact). Each series is evaluated independently.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by(instance, node) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Memory usage % — current",
      "description": "Warning when usage stays > 85% for 4h. CPU uses a 5-minute idle rate; root disk uses available space (including reserved-space impact). Each series is evaluated independently.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by(instance, node) (100 * (1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})))",
          "refId": "A",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ]
    },
