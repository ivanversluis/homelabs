    {
      "type": "gauge",
      "title": "TSDB + WAL vs configured 50 GB retention budget",
      "description": "Prometheus --storage.tsdb.retention.size=50GB uses decimal bytes. This is a retention budget, not filesystem/PVC utilization; head and temporary files need additional space.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(prometheus_tsdb_storage_blocks_bytes + prometheus_tsdb_wal_storage_size_bytes) / 50e9 * 100",
          "refId": "A",
