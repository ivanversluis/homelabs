              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*failure.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
