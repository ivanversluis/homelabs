        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": false,
              "instance": false,
              "app": true
            },
            "indexByName": {
              "job": 0,
              "method": 1,
              "endpoint": 2,
              "Value": 3
            },
            "renameByName": {
              "job": "Service",
              "method": "Method",
              "endpoint": "Endpoint",
              "Value": "Total"
            }
